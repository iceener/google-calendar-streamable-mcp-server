{
  "name": "google-calendar-mcp",
  "version": "1.0.0",
  "description": "MCP Server for Google Calendar - list, search, create, update, and delete events with OAuth",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "dev:worker": "wrangler dev --config wrangler.jsonc",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "build:worker": "wrangler deploy --dry-run --outdir dist/worker --config wrangler.jsonc",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy:tail": "wrangler tail --config wrangler.jsonc",
    "kv:create": "wrangler kv namespace create TOKENS --config wrangler.jsonc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "types:worker": "wrangler types --config wrangler.jsonc --env-file env.example",
    "types:worker:check": "wrangler types --check --config wrangler.jsonc --env-file env.example",
    "test": "bun test",
    "test:protocol": "bun test tests/protocol.test.ts",
    "test:workerd": "bun run tests/workerd-protocol.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-calendar",
    "oauth",
    "cloudflare-workers"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "hono": "^4.11.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.14",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@modelcontextprotocol/client": "2.0.0-beta.5",
    "@types/node": "^24.10.0",
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20.0.0"
  }
}
